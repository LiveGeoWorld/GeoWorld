          "reviews": [
            {
              "review_id": "places/ChIJu6qq6Y0Z2jERZQZRLwnba5k/reviews/Ci9DQUlRQUNvZENodHljRjlvT21sVlZGVmFPVlpCV0Uwd2FIWmxZM0psTlhaUmRIYxAB",
              "text": "ION Orchard delivers a high-end shopping experience right in the heart of Orchard Road. The architecture is striking, and the mall houses a wide range of luxury brands alongside stylish dining spots. It’s always lively and well-maintained, though it can feel overwhelming due to its size. Still, one of the most iconic retail destinations in Singapore.",
              "original_text": "ION Orchard delivers a high-end shopping experience right in the heart of Orchard Road. The architecture is striking, and the mall houses a wide range of luxury brands alongside stylish dining spots. It’s always lively and well-maintained, though it can feel overwhelming due to its size. Still, one of the most iconic retail destinations in Singapore.",
              "language_code": "en",
              "rating": 5,
              "relative_publish_time": "3 months ago",
              "publish_time": "2026-04-02T07:17:09.854622146Z",
              "author_display_name": "Tran Julie",
              "author_uri": "https://www.google.com/maps/contrib/110829604676593487794/reviews"
            },
            {
              "review_id": "places/ChIJu6qq6Y0Z2jERZQZRLwnba5k/reviews/Ci9DQUlRQUNvZENodHljRjlvT21WWlpXeEVNbmMwT0VWRGVGQldkRmRqUmw4MGMzYxAB",
              "text": "It wasn't a goal on my list. I visited it only because through it you have access to ION Sky, an observation deck. What I liked is the absolutely unique architecture, very beautiful. Otherwise, it has nothing extra compared to other malls.",
              "original_text": "It wasn't a goal on my list. I visited it only because through it you have access to ION Sky, an observation deck. What I liked is the absolutely unique architecture, very beautiful. Otherwise, it has nothing extra compared to other malls.",
              "language_code": "en",
